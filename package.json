{
  "name": "mtga-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Background companion app for MTG Arena: reads Player.log to capture match, draft and deck data. Milestone 1: headless raw-event logger.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "start": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "test:parser": "tsx src/log/logParser.test.ts",
    "test:classifier": "tsx src/domain/classifier.test.ts",
    "test": "npm run test:parser && npm run test:classifier",
    "backfill": "tsx src/backfill.ts",
    "report": "tsx src/report.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
